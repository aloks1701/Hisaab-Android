<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up. The ledger is financial data, and the product claims it stays on
  this phone. Android Auto Backup would upload it to the user's Google Drive without the app
  holding INTERNET, because the OS performs the upload - which would make that claim false
  in exactly the way nobody would notice.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
