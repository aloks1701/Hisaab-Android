<?xml version="1.0" encoding="utf-8"?>
<!--
  Same reasoning as backup_rules.xml, for API 31+. Device-to-device transfer is excluded too:
  moving the ledger to a new phone is a feature worth having, but it should be an explicit
  export the user asks for, not a silent copy they never seen consent to.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
